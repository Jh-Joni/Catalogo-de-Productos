---
import { productos } from '../data/productos.js';

// CONFIGURACIÓN: Ingresa tu número de WhatsApp aquí (con código de país, sin espacios ni el signo +)
const WHATSAPP_PHONE = '593967998349';
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Catálogo Exclusivo - Arte en Flores & Regalos Únicos</title>
  
  <!-- Google Fonts: Playfair Display para elegancia, Montserrat para legibilidad moderna -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-dark: #0f0814; /* Púrpura muy oscuro casi negro */
      --bg-gradient: linear-gradient(145deg, #1a0b1c 0%, #0f0814 100%);
      --accent-gold: #d4af37; /* Oro elegante */
      --accent-gold-hover: #f3d56a;
      --accent-rose: #b76e79; /* Oro rosado / Rosa viejo */
      --card-bg: rgba(255, 255, 255, 0.03);
      --card-border: rgba(212, 175, 55, 0.15);
      --text-main: #fdfbf7;
      --text-muted: #c4b8b5;
      --font-serif: 'Playfair Display', serif;
      --font-sans: 'Montserrat', sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-sans);
      background: var(--bg-dark);
      background-image: radial-gradient(circle at 50% 0%, #2d142c 0%, transparent 50%),
                        radial-gradient(circle at 100% 100%, #1a0b1c 0%, transparent 50%);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* Animación de partículas flotantes simulando pétalos/luces */
    .particles {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      pointer-events: none;
      z-index: 0;
      background-image: 
        radial-gradient(circle at 20% 30%, rgba(183, 110, 121, 0.05) 0%, transparent 10%),
        radial-gradient(circle at 80% 60%, rgba(212, 175, 55, 0.05) 0%, transparent 10%);
    }

    /* Header & Hero Section */
    header {
      position: relative;
      padding: 100px 20px 80px;
      text-align: center;
      z-index: 1;
      border-bottom: 1px solid rgba(212, 175, 55, 0.2);
      background: linear-gradient(to bottom, rgba(15, 8, 20, 0.2), rgba(15, 8, 20, 1));
    }

    /* Fondo floral sutil para el hero */
    header::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: url('https://images.unsplash.com/photo-1546842931-886c185b4c8c?q=80&w=1200&auto=format&fit=crop') center/cover;
      opacity: 0.15;
      z-index: -1;
      mix-blend-mode: overlay;
    }

    .brand-subtitle {
      font-family: var(--font-sans);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 4px;
      color: var(--accent-gold);
      margin-bottom: 15px;
      display: block;
    }

    h1 {
      font-family: var(--font-serif);
      font-size: 56px;
      color: #ffffff;
      margin-bottom: 20px;
      font-weight: 600;
      line-height: 1.1;
      text-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }

    h1 span {
      color: var(--accent-rose);
      font-style: italic;
    }

    .tagline {
      font-size: 18px;
      color: var(--text-muted);
      max-width: 650px;
      margin: 0 auto;
      font-weight: 300;
      line-height: 1.8;
    }

    /* Main Container */
    main {
      flex: 1;
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 60px 20px;
      z-index: 1;
      position: relative;
    }

    /* Grid Layout */
    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 40px;
    }

    /* Product Card - Glassmorphism Premium */
    .product-card {
      background: var(--card-bg);
      border-radius: 20px;
      overflow: hidden;
      border: 1px solid var(--card-border);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transition: all 0.5s cubic-bezier(0.25, 1, 0.5, 1);
      display: flex;
      flex-direction: column;
      position: relative;
      box-shadow: 0 15px 35px rgba(0,0,0,0.2);
    }

    .product-card:hover {
      transform: translateY(-10px);
      border-color: var(--accent-gold);
      box-shadow: 0 20px 40px rgba(212, 175, 55, 0.15), 0 0 20px rgba(183, 110, 121, 0.1);
    }

    .image-wrapper {
      position: relative;
      width: 100%;
      padding-top: 110%; /* Ligeramente más alto que cuadrado para más elegancia */
      overflow: hidden;
      background: #111;
    }

    .product-image {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.8s ease;
      opacity: 0.9;
    }

    .product-card:hover .product-image {
      transform: scale(1.1);
      opacity: 1;
    }

    /* Efecto de viñeta sobre la imagen */
    .image-wrapper::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; width: 100%; height: 50%;
      background: linear-gradient(to top, rgba(15, 8, 20, 0.9), transparent);
    }

    .price-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 15px;
    }

    .price-badge {
      display: inline-block;
      background: var(--accent-gold);
      color: #000;
      padding: 8px 20px;
      border-radius: 30px;
      font-weight: 700;
      font-size: 18px;
      box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
      font-family: var(--font-sans);
      letter-spacing: 1px;
    }

    .category-badge {
      display: inline-block;
      background: rgba(183, 110, 121, 0.15);
      color: var(--accent-rose);
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.5px;
      border: 1px solid rgba(183, 110, 121, 0.3);
      text-transform: uppercase;
    }

    .card-info {
      padding: 30px 25px 25px;
      display: flex;
      flex-direction: column;
      flex: 1;
      justify-content: space-between;
      position: relative;
      z-index: 2;
    }

    .product-name {
      font-family: var(--font-serif);
      font-size: 22px;
      color: var(--text-main);
      margin-bottom: 12px;
      line-height: 1.3;
      font-weight: 400;
    }

    .product-description {
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.7;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 25px;
      font-weight: 300;
    }

    /* Botón WhatsApp Elegante */
    .whatsapp-btn {
      width: 100%;
      padding: 14px 20px;
      background: transparent;
      color: var(--accent-gold);
      text-decoration: none;
      border-radius: 12px;
      font-weight: 500;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 1px;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      border: 1px solid var(--accent-gold);
      transition: all 0.3s ease;
    }

    .whatsapp-btn:hover {
      background: var(--accent-gold);
      color: #000;
      box-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
    }

    .whatsapp-icon {
      width: 20px;
      height: 20px;
      fill: currentColor;
    }

    /* Estado de Error y Vacío */
    .status-container {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(212, 175, 55, 0.2);
      padding: 40px;
      border-radius: 20px;
      text-align: center;
      max-width: 600px;
      margin: 0 auto 40px;
      backdrop-filter: blur(10px);
    }

    .status-container h3 {
      font-family: var(--font-serif);
      font-size: 24px;
      color: var(--accent-gold);
      margin-bottom: 15px;
    }

    .status-container p {
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 20px;
    }

    /* Footer */
    footer {
      padding: 40px 20px;
      text-align: center;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      font-size: 13px;
      color: rgba(255, 255, 255, 0.3);
      z-index: 1;
    }

    @media (max-width: 768px) {
      h1 { font-size: 40px; }
      header { padding: 80px 15px 50px; }
      .catalog-grid { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 25px; }
    }
  </style>
</head>
<body>
  <div class="particles"></div>

  <header>
    <span class="brand-subtitle">Catálogo Exclusivo</span>
    <h1>Arte en Flores & <br><span>Regalos Únicos</span></h1>
    <p class="tagline">Cada pieza es tejida a mano con amor, creando recuerdos eternos para esa persona especial. Explora nuestra colección exclusiva.</p>
  </header>

  <main>
    {productos.length === 0 ? (
      <div class="status-container">
        <h3>Catálogo en Preparación</h3>
        <p>Estamos tejiendo cosas hermosas para ti. Muy pronto encontrarás aquí nuestra colección de flores y detalles para parejas.</p>
      </div>
    ) : (
      <div class="catalog-grid">
        {productos.map((producto) => {
          const precioFormateado = `$${Number(producto.precio).toFixed(2)}`;
          const mensajeWhatsApp = encodeURIComponent(
            `¡Hola! Me encantó el producto "${producto.nombre}" de su catálogo exclusivo. ¿Podrían darme más información?`
          );
          const enlaceWhatsApp = `https://wa.me/${WHATSAPP_PHONE}?text=${mensajeWhatsApp}`;

          return (
            <div class="product-card">
              <div class="image-wrapper">
                <img 
                  class="product-image" 
                  src={producto.imagen || producto.imagen_url || "https://images.unsplash.com/photo-1546842931-886c185b4c8c?q=80&w=600&auto=format&fit=crop"} 
                  alt={producto.nombre} 
                  loading="lazy"
                />
              </div>
              
              <div class="card-info">
                <div class="price-container">
                  <span class="price-badge">{precioFormateado}</span>
                  {producto.categoria && <span class="category-badge">{producto.categoria}</span>}
                </div>
                
                <div class="card-details">
                  <h2 class="product-name">{producto.nombre}</h2>
                  <p class="product-description" title={producto.descripcion}>
                    {producto.descripcion || "Hermoso detalle artesanal tejido a mano."}
                  </p>
                </div>
                
                <a 
                  class="whatsapp-btn" 
                  href={enlaceWhatsApp}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg class="whatsapp-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.458 5.705 1.459h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"/>
                  </svg>
                  Solicitar por WhatsApp
                </a>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </main>

  <footer>
    <p>&copy; {new Date().getFullYear()} Catálogo Exclusivo. Todos los derechos reservados.</p>
  </footer>
</body>
</html>